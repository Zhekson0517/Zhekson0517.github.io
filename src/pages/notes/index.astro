---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getCollection } from 'astro:content';

const allNotes = (await getCollection('notes'))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const allTags = [...new Set(allNotes.flatMap(n => n.data.tags))].sort();
const allCategories = [...new Set(allNotes.map(n => n.data.category))].sort();

const PAGE_SIZE = 12;
const page = Number(Astro.url.searchParams.get('page')) || 1;
const totalPages = Math.ceil(allNotes.length / PAGE_SIZE);
const pagedNotes = allNotes.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const searchData = allNotes.map(n => ({
  id: n.id,
  title: n.data.title,
  abstract: n.data.abstract,
  tags: n.data.tags,
  category: n.data.category,
  date: n.data.publishedAt,
}));
---

<BaseLayout title="Machine Learning Notes" description="Academic notes on machine learning theory, algorithms, and applications.">
  <section class="fade-in">
    <h1 class="section-title">Machine Learning Academic Notes</h1>

    <div class="search-section" style="margin-bottom: 1.5em;">
      <input type="text" class="search-input" id="note-search" placeholder="Search notes by title, tags, or abstract..." />
    </div>

    <div class="filter-bar" id="category-filters">
      <button class="filter-btn active" data-category="all">All</button>
      {allCategories.map(cat => (
        <button class="filter-btn" data-category={cat}>{cat}</button>
      ))}
    </div>

    <div class="tag-cloud" id="tag-cloud">
      {allTags.map(tag => (
        <a href="#" class="tag" data-tag={tag}>{tag}</a>
      ))}
    </div>

    <div id="notes-list">
      {pagedNotes.map(note => (
        <div class="note-item" data-note-id={note.id} data-tags={note.data.tags.join(',')} data-category={note.data.category}>
          <NoteCard
            title={note.data.title}
            href={`/notes/${note.id}`}
            date={note.data.publishedAt}
            abstract={note.data.abstract}
            tags={note.data.tags}
            category={note.data.category}
          />
        </div>
      ))}
    </div>

    {totalPages > 1 && (
      <div class="pagination">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
          p === page
            ? <span class="active">{p}</span>
            : <a href={`?page=${p}`}>{p}</a>
        ))}
      </div>
    )}
  </section>

  <script define:vars={{ data: searchData }}>
    var notesData = data;
    var searchInput = document.getElementById('note-search');
    var categoryFilters = document.getElementById('category-filters');
    var tagCloud = document.getElementById('tag-cloud');
    var notesList = document.getElementById('notes-list');

    var activeCategory = 'all';
    var activeTag = null;
    var searchQuery = '';

    function filterNotes() {
      var filtered = notesData.filter(function(note) {
        var matchCategory = activeCategory === 'all' || note.category === activeCategory;
        var matchTag = !activeTag || note.tags.indexOf(activeTag) !== -1;
        var q = searchQuery.toLowerCase();
        var matchSearch = !q ||
          note.title.toLowerCase().indexOf(q) !== -1 ||
          note.abstract.toLowerCase().indexOf(q) !== -1 ||
          note.tags.some(function(t) { return t.toLowerCase().indexOf(q) !== -1; });
        return matchCategory && matchTag && matchSearch;
      });

      var items = notesList.querySelectorAll('.note-item');
      items.forEach(function(item) {
        var id = item.getAttribute('data-note-id');
        if (filtered.some(function(n) { return n.id === id; })) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        searchQuery = this.value;
        filterNotes();
      });
    }

    if (categoryFilters) {
      categoryFilters.addEventListener('click', function(e) {
        if (e.target.classList.contains('filter-btn')) {
          categoryFilters.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
          e.target.classList.add('active');
          activeCategory = e.target.getAttribute('data-category');
          filterNotes();
        }
      });
    }

    if (tagCloud) {
      tagCloud.addEventListener('click', function(e) {
        e.preventDefault();
        if (e.target.classList.contains('tag')) {
          var tag = e.target.getAttribute('data-tag');
          if (activeTag === tag) {
            activeTag = null;
            e.target.classList.remove('active');
          } else {
            tagCloud.querySelectorAll('.tag').forEach(function(t) { t.classList.remove('active'); });
            e.target.classList.add('active');
            activeTag = tag;
          }
          filterNotes();
        }
      });
    }
  </script>
</BaseLayout>
