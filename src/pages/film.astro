---
import BaseLayout from '../layouts/BaseLayout.astro';
import films from '../data/films.json';

const watched = films
  .filter(f => f.watchedAt)
  .sort((a, b) => new Date(b.watchedAt).getTime() - new Date(a.watchedAt).getTime());

const unwatched = films.filter(f => !f.watchedAt);

function getMonthKey(dateStr: string): string {
  const d = new Date(dateStr);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
}

function formatMonth(key: string): string {
  const [y, m] = key.split('-');
  return `${y} 年 ${parseInt(m)} 月`;
}

const monthKeys = [...new Set(watched.map(f => getMonthKey(f.watchedAt)))];

const grouped: Record<string, typeof watched> = {};
watched.forEach(f => {
  const key = getMonthKey(f.watchedAt);
  if (!grouped[key]) grouped[key] = [];
  grouped[key].push(f);
});

const totalCount = films.length;
const watchedCount = watched.length;
---

<BaseLayout title="Film" description="Film collection — 观影记录时间线。">
  <section class="fade-in">
    <h1 class="section-title">Film</h1>
    <p class="film-intro">
      观影记录，按观看时间排列。已看 {watchedCount} / {totalCount} 部。
    </p>

    <div class="month-nav">
      {monthKeys.map(key => (
        <a href={`#month-${key}`} class="month-link">{formatMonth(key)}</a>
      ))}
      {unwatched.length > 0 && (
        <a href="#unwatched" class="month-link month-link--unwatched">待看 ({unwatched.length})</a>
      )}
    </div>

    <div class="timeline">
      {monthKeys.map(key => {
        const monthFilms = grouped[key];
        return (
          <div class="month-group" id={`month-${key}`}>
            <div class="month-marker">{formatMonth(key)}</div>
            <div class="month-films">
              {monthFilms.map(film => (
                <div class="film-card fade-in">
                  <div class="film-watched-date">{film.watchedAt.slice(5)}</div>
                  <div class="film-body">
                    <div class="film-title-row">
                      <span class="film-title">{film.title}</span>
                      <span class="film-title-en">{film.titleEn}</span>
                    </div>
                    <div class="film-meta">
                      <span class="film-year">{film.year}</span>
                      <span class="film-sep">·</span>
                      <span class="film-director">{film.director}</span>
                      <span class="film-sep">·</span>
                      <span class="film-country">{film.country}</span>
                    </div>
                    <div class="film-genre">{film.genre}</div>
                    <div class="film-quote">「{film.quote}」</div>
                    <div class="film-rating">
                      <span class="rating-star">★</span>
                      <span class="rating-score">{film.rating}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      {unwatched.length > 0 && (
        <div class="month-group month-group--unwatched" id="unwatched">
          <div class="month-marker month-marker--unwatched">待看</div>
          <div class="month-films">
            {unwatched.map(film => (
              <div class="film-card film-card--unwatched fade-in">
                <div class="film-rank">#{film.rank}</div>
                <div class="film-body">
                  <div class="film-title-row">
                    <span class="film-title">{film.title}</span>
                    <span class="film-title-en">{film.titleEn}</span>
                  </div>
                  <div class="film-meta">
                    <span class="film-year">{film.year}</span>
                    <span class="film-sep">·</span>
                    <span class="film-director">{film.director}</span>
                    <span class="film-sep">·</span>
                    <span class="film-country">{film.country}</span>
                  </div>
                  <div class="film-genre">{film.genre}</div>
                  <div class="film-quote">「{film.quote}」</div>
                  <div class="film-rating">
                    <span class="rating-star">★</span>
                    <span class="rating-score">{film.rating}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .film-intro {
    text-indent: 0;
    margin-bottom: 1.5em;
    color: var(--color-secondary);
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
  }

  .month-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-bottom: 2em;
    padding-bottom: 1em;
    border-bottom: 1px solid var(--color-border);
  }

  .month-link {
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
    padding: 0.3em 0.8em;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .month-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-tag-bg);
  }

  .month-link--unwatched {
    border-style: dashed;
  }

  .timeline {
    position: relative;
    padding-left: 3em;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 1.2em;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .month-group {
    margin-bottom: 2.5em;
    position: relative;
  }

  .month-marker {
    font-family: var(--font-sans);
    font-size: 15pt;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.8em;
    position: relative;
  }

  .month-marker::before {
    content: '';
    position: absolute;
    left: -2.1em;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .month-marker--unwatched {
    color: var(--color-secondary);
  }

  .month-marker--unwatched::before {
    background: var(--color-secondary);
    box-shadow: 0 0 0 2px var(--color-secondary);
  }

  .month-films {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .film-card {
    display: flex;
    gap: 1em;
    padding: 0.8em 1em;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-bg);
    transition: all var(--transition-normal);
    position: relative;
  }

  .film-card::before {
    content: '';
    position: absolute;
    left: -2.05em;
    top: 1.2em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background var(--transition-fast);
  }

  .film-card:hover {
    transform: translateX(4px);
    border-color: var(--color-accent);
    box-shadow: 0 2px 8px var(--color-card-shadow);
  }

  .film-card:hover::before {
    background: var(--color-accent);
  }

  .film-card--unwatched {
    opacity: 0.6;
    border-style: dashed;
  }

  .film-card--unwatched:hover {
    opacity: 0.85;
  }

  .film-watched-date {
    font-family: var(--font-mono);
    font-size: 11pt;
    font-weight: 600;
    color: var(--color-accent);
    min-width: 2.5em;
    display: flex;
    align-items: flex-start;
    padding-top: 0.1em;
  }

  .film-rank {
    font-family: var(--font-sans);
    font-size: 12pt;
    font-weight: 700;
    color: var(--color-accent);
    min-width: 2.5em;
    display: flex;
    align-items: flex-start;
    padding-top: 0.1em;
  }

  .film-body {
    flex: 1;
    min-width: 0;
  }

  .film-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    flex-wrap: wrap;
    margin-bottom: 0.2em;
  }

  .film-title {
    font-family: var(--font-sans);
    font-size: 12pt;
    font-weight: 600;
    color: var(--color-heading);
  }

  .film-title-en {
    font-family: var(--font-serif);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    font-style: italic;
  }

  .film-meta {
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    margin-bottom: 0.2em;
  }

  .film-sep {
    margin: 0 0.3em;
  }

  .film-genre {
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    margin-bottom: 0.3em;
  }

  .film-quote {
    font-family: var(--font-serif);
    font-size: var(--font-size-small);
    color: var(--color-text);
    font-style: italic;
    line-height: 1.5;
    margin-bottom: 0.2em;
  }

  .film-rating {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  .rating-star {
    color: #f5a623;
    font-size: 12pt;
  }

  .rating-score {
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .month-nav {
      gap: 0.4em;
    }

    .month-link {
      font-size: 9pt;
      padding: 0.25em 0.6em;
    }

    .timeline {
      padding-left: 2em;
    }

    .timeline::before {
      left: 0.5em;
    }

    .month-marker {
      font-size: 13pt;
    }

    .month-marker::before {
      left: -1.7em;
      width: 10px;
      height: 10px;
    }

    .film-card::before {
      left: -1.65em;
      width: 6px;
      height: 6px;
    }

    .film-card {
      flex-direction: column;
      gap: 0.3em;
      padding: 0.6em 0.8em;
    }

    .film-watched-date,
    .film-rank {
      min-width: auto;
      font-size: 11pt;
    }

    .film-title-row {
      flex-direction: column;
      gap: 0.1em;
    }

    .film-title {
      font-size: 11pt;
    }

    .film-meta {
      font-size: 9pt;
      flex-wrap: wrap;
    }

    .film-sep {
      margin: 0 0.2em;
    }

    .film-quote {
      font-size: 9pt;
    }
  }
</style>
