---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div class="page-404 fade-in">
    <div class="error-container">
      <div class="error-code">
        <span class="digit">4</span>
        <span class="digit digit-error">0</span>
        <span class="digit">4</span>
      </div>
      
      <div class="error-message">
        <h1>Page Not Found</h1>
        <p class="error-subtitle">The page you're looking for seems to have vanished into the void.</p>
      </div>
      
      <div class="error-content">
        <div class="error-quote">
          <p>
            <span class="quote-symbol">"</span>
            In the vast space of possibilities, this page exists in a superposition of being and not being.
            <span class="quote-symbol">"</span>
          </p>
          <p class="quote-author">— Schrödinger's Web Page</p>
        </div>
        
        <div class="error-suggestions">
          <p class="suggestions-title">Maybe you were looking for:</p>
          <ul class="suggestion-list">
            <li><a href="/ml">Machine Learning Notes</a></li>
            <li><a href="/embedded">Embedded Systems</a></li>
            <li><a href="/film">Film Collection</a></li>
            <li><a href="/archive">Complete Archive</a></li>
          </ul>
        </div>
      </div>
      
      <div class="error-actions">
        <a href="/" class="btn btn-primary">
          <span class="btn-icon">🏠</span>
          Return Home
        </a>
        <a href="/search" class="btn btn-secondary">
          <span class="btn-icon">🔍</span>
          Search
        </a>
      </div>
      
      <div class="error-technical">
        <p class="technical-note">
          <span class="code-comment">// Error Code:</span><br>
          <span class="code-keyword">const</span> <span class="code-var">status</span> = <span class="code-number">404</span>;<br>
          <span class="code-keyword">const</span> <span class="code-var">message</span> = <span class="code-string">"NOT_FOUND"</span>;<br>
          <span class="code-keyword">if</span> (<span class="code-var">url</span> !== <span class="code-string">"/404"</span>) {<br>
          &nbsp;&nbsp;<span class="code-var">redirect</span>(<span class="code-string">"/"</span>);<br>
          }
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-404 {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2em 1em;
  }

  .error-container {
    max-width: 800px;
    width: 100%;
    text-align: center;
  }

  .error-code {
    display: flex;
    justify-content: center;
    gap: 0.3em;
    margin-bottom: 0.5em;
    font-family: var(--font-mono);
    font-size: clamp(80px, 15vw, 180px);
    font-weight: 700;
    line-height: 1;
    user-select: none;
  }

  .digit {
    color: var(--color-accent);
    position: relative;
    transition: all var(--transition-normal);
  }

  .digit-error {
    animation: glitch 2s ease-in-out infinite;
    position: relative;
  }

  .digit-error::before,
  .digit-error::after {
    content: '0';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }

  .digit-error::before {
    animation: glitch-offset-1 0.3s ease-in-out infinite alternate;
    color: #ff6b6b;
  }

  .digit-error::after {
    animation: glitch-offset-2 0.3s ease-in-out infinite alternate;
    color: #4ecdc4;
  }

  @keyframes glitch {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(-2px, 2px); }
    40% { transform: translate(-2px, -2px); }
    60% { transform: translate(2px, 2px); }
    80% { transform: translate(2px, -2px); }
  }

  @keyframes glitch-offset-1 {
    0%, 100% { clip-path: inset(0 0 0 0); transform: translate(-2px, -2px); }
    25% { clip-path: inset(20% 0 60% 0); transform: translate(-3px, -3px); }
    50% { clip-path: inset(40% 0 40% 0); transform: translate(-2px, -2px); }
    75% { clip-path: inset(60% 0 20% 0); transform: translate(-1px, -1px); }
  }

  @keyframes glitch-offset-2 {
    0%, 100% { clip-path: inset(0 0 0 0); transform: translate(2px, 2px); }
    25% { clip-path: inset(60% 0 20% 0); transform: translate(3px, 3px); }
    50% { clip-path: inset(40% 0 40% 0); transform: translate(2px, 2px); }
    75% { clip-path: inset(20% 0 60% 0); transform: translate(1px, 1px); }
  }

  .error-message {
    margin-bottom: 2em;
  }

  .error-message h1 {
    font-family: var(--font-sans);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 0.5em;
  }

  .error-subtitle {
    font-family: var(--font-serif);
    font-size: clamp(14px, 2.5vw, 18px);
    color: var(--color-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .error-content {
    margin: 2.5em 0;
    padding: 2em;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .error-quote {
    margin-bottom: 2em;
    padding: 1.5em;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg);
  }

  .error-quote p {
    font-family: var(--font-serif);
    font-size: clamp(14px, 2.5vw, 16px);
    font-style: italic;
    color: var(--color-text);
    line-height: 1.8;
    margin-bottom: 0.5em;
  }

  .quote-symbol {
    color: var(--color-accent);
    font-size: 1.2em;
  }

  .quote-author {
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    text-align: right;
    font-style: normal;
  }

  .error-suggestions {
    text-align: left;
  }

  .suggestions-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    color: var(--color-heading);
    margin-bottom: 1em;
    font-weight: 600;
  }

  .suggestion-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.8em;
  }

  .suggestion-list li {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
  }

  .suggestion-list a {
    display: block;
    padding: 0.6em 1em;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .suggestion-list a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .error-actions {
    display: flex;
    gap: 1em;
    justify-content: center;
    flex-wrap: wrap;
    margin: 2em 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.8em 1.5em;
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all var(--transition-normal);
    cursor: pointer;
  }

  .btn-icon {
    font-size: 1.2em;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white;
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--color-card-shadow-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .error-technical {
    margin-top: 3em;
    padding: 1.5em;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-align: left;
    overflow-x: auto;
  }

  .technical-note {
    font-family: var(--font-mono);
    font-size: clamp(12px, 2vw, 14px);
    line-height: 1.8;
    margin: 0;
    color: var(--color-text);
  }

  .code-comment {
    color: #6a9955;
  }

  .code-keyword {
    color: #569cd6;
  }

  .code-var {
    color: #9cdcfe;
  }

  .code-number {
    color: #b5cea8;
  }

  .code-string {
    color: #ce9178;
  }

  /* Mobile Optimization */
  @media (max-width: 768px) {
    .page-404 {
      padding: 1.5em 1em;
      min-height: auto;
    }

    .error-code {
      gap: 0.15em;
    }

    .error-content {
      padding: 1.5em;
      margin: 2em 0;
    }

    .error-quote {
      padding: 1em;
      margin-bottom: 1.5em;
    }

    .suggestion-list {
      grid-template-columns: 1fr;
    }

    .error-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.8em;
    }

    .btn {
      justify-content: center;
      padding: 0.9em 1.5em;
    }

    .error-technical {
      margin-top: 2em;
      padding: 1em;
    }

    .technical-note {
      font-size: 12px;
    }
  }

  /* Dark mode adjustments */
  :root.dark .code-comment {
    color: #6a9955;
  }

  :root.dark .code-keyword {
    color: #569cd6;
  }

  :root.dark .code-var {
    color: #9cdcfe;
  }

  :root.dark .code-number {
    color: #b5cea8;
  }

  :root.dark .code-string {
    color: #ce9178;
  }
</style>
