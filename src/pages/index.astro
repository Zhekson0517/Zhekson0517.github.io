---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getCollection } from 'astro:content';

type NoteLike = {
  data: {
    title: string;
    slug: string;
    publishedAt: string;
    category: string;
    tags: string[];
    abstract: string;
  };
  collection: string;
};

const mlNotes = (await getCollection('notes')) as NoteLike[];
const embeddedNotes = (await getCollection('embedded')) as NoteLike[];

const allNotes = [...mlNotes, ...embeddedNotes]
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 6);

function getHref(note: NoteLike) {
  return note.collection === 'embedded' ? `/embedded/${note.data.slug}` : `/ml/${note.data.slug}`;
}
---

<BaseLayout title="Zhe's Blog" description="Personal academic blog focusing on machine learning and embedded systems.">
  <section class="home-hero fade-in">
    <h1>Zhe</h1>
    <p class="subtitle">Undergraduate &middot; Computer Science & Artificial Intelligence</p>
    <p class="institution">Hunan University</p>
    <p class="bio">
      Junior student in the Artificial Intelligence Experimental Class at the College of Computer Science and Electronic Engineering,
      Hunan University. Focused on machine learning theory, optimization algorithms, and their applications
      in real-world systems.
    </p>
    <div class="home-links">
      <a href="https://github.com/zhekson0517" target="_blank" rel="noopener">GitHub</a>
      <a href="mailto:zhe@example.com">Email</a>
      <a href="/ml">ML Chapters &rarr;</a>
      <a href="/embedded">Embedded Chapters &rarr;</a>
    </div>
  </section>

  <section class="fade-in fade-in-delay-2">
    <h2 class="section-title">Latest Chapters</h2>
    {allNotes.map(note => (
      <NoteCard
        title={note.data.title}
        href={getHref(note)}
        date={note.data.publishedAt}
        abstract={note.data.abstract}
        tags={note.data.tags}
        category={note.data.category}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .home-hero {
    margin-bottom: 3em;
  }

  .home-hero h1 {
    font-size: 2em;
    margin-bottom: 0.3em;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-size: 11pt;
    color: var(--color-secondary);
    margin-bottom: 0.3em;
    text-indent: 0;
  }

  .institution {
    font-family: var(--font-sans);
    font-size: 10pt;
    color: var(--color-secondary);
    margin-bottom: 1em;
    text-indent: 0;
  }

  .bio {
    font-size: var(--font-size-body);
    line-height: 1.6;
    margin-bottom: 1.5em;
    text-indent: 0;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8em 1.5em;
  }

  .home-links a {
    font-family: var(--font-sans);
    font-size: 10pt;
    color: var(--color-link);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .home-links a:hover {
    color: var(--color-link-hover);
  }

  @media (max-width: 768px) {
    .home-hero h1 {
      font-size: 1.6em;
    }

    .bio {
      font-size: 10pt;
    }

    .home-links {
      gap: 0.6em 1.2em;
    }
  }
</style>
