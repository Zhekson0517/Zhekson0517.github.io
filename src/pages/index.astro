---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getCollection } from 'astro:content';

type NoteLike = {
  data: {
    title: string;
    slug: string;
    publishedAt: string;
    category: string;
    tags: string[];
    abstract: string;
  };
  collection: string;
};

const mlNotes = (await getCollection('notes')) as NoteLike[];
const embeddedNotes = (await getCollection('embedded')) as NoteLike[];

const allNotes = [...mlNotes, ...embeddedNotes]
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 6);

function getHref(note: NoteLike) {
  return note.collection === 'embedded' ? `/embedded/${note.data.slug}` : `/ml/${note.data.slug}`;
}
---

<BaseLayout title="Zhe's Blog" description="Personal academic blog focusing on machine learning and embedded systems.">
  <section class="home-hero fade-in">
    <h1>Zhe</h1>
    <p class="subtitle">Graduate Student &middot; Machine Learning & Systems</p>
    <p class="institution">University of Technology</p>
    <p class="bio">
      Researching machine learning theory, optimization algorithms, and their applications
      in real-world systems. Focused on bridging the gap between theoretical foundations
      and practical implementations.
    </p>
    <div class="home-links">
      <a href="https://github.com/zhe" target="_blank" rel="noopener">GitHub</a>
      <a href="mailto:zhe@example.com">Email</a>
      <a href="https://scholar.google.com" target="_blank" rel="noopener">Google Scholar</a>
      <a href="/ml">ML Chapters &rarr;</a>
      <a href="/embedded">Embedded Chapters &rarr;</a>
    </div>
  </section>

  <section class="fade-in fade-in-delay-2">
    <h2 class="section-title">Latest Chapters</h2>
    {allNotes.map(note => (
      <NoteCard
        title={note.data.title}
        href={getHref(note)}
        date={note.data.publishedAt}
        abstract={note.data.abstract}
        tags={note.data.tags}
        category={note.data.category}
      />
    ))}
  </section>
</BaseLayout>
